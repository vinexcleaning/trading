# Recorded data and the SQLite DB stay local.
data/
.venv/
__pycache__/
*.pyc

# Never commit the key.
.env

# Phase 2 onward: reports attach honesty judgments to named real people, and this
# repo is PUBLIC. Code is committed; judgments stay local.
reports/

# The knowledge base names real creators alongside honesty scores. Local only.
# The glob matters: build_knowledge.py now emits one file PER CORPUS
# (KNOWLEDGE_kalshi_edge.md and so on), and a bare `KNOWLEDGE.md` line would
# have left every one of those UNTRACKED-BUT-COMMITTABLE in a public repo.
KNOWLEDGE.md
KNOWLEDGE_*.md

# Hand-carried corpora from another machine. Same content, same rule.
_from_laptop/
