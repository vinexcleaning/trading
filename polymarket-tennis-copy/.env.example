# Tennis Copy-Trade Intelligence -- example configuration.
#
# Copy to .env and edit. Every value below has a working default, so the
# application starts with no .env at all; this file exists to document the knobs
# and to hold your credentials.
#
# Secrets are read from the environment only. They are never written to the
# database, never returned by the API, and are scrubbed from logs.

# ----------------------------------------------------------------- runtime
APP_ENV=development                  # development | production | test
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                       # true for structured JSON logs in production
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- database
# SQLite is the default and needs no setup. For production use Postgres:
# DATABASE_URL=postgresql+psycopg://tennis:tennis@localhost:5432/tennis
# DATABASE_URL=sqlite:///./data/tennis_copy_trade.db
DB_ECHO=false

# ------------------------------------------------------------- data source
# Public Polymarket endpoints. No credentials are required or used.
GAMMA_BASE_URL=https://gamma-api.polymarket.com
DATA_API_BASE_URL=https://data-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
LEADERBOARD_BASE_URL=https://lb-api.polymarket.com

# Gamma tag id for Tennis (verified against the live API).
TENNIS_TAG_ID=864

HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=4
# Self-imposed throttle. Polymarket publishes no rate-limit headers, so this is
# deliberately conservative rather than probing for the ceiling.
HTTP_REQUESTS_PER_SECOND=6

# ---------------------------------------------------------------- ingestion
SYNC_INTERVAL_SECONDS=300            # wallet activity refresh
LIVE_SYNC_INTERVAL_SECONDS=30        # signal scan
MARKET_REFRESH_INTERVAL_SECONDS=900  # tennis market metadata
METRICS_RECOMPUTE_INTERVAL_SECONDS=1800
WALLET_BACKFILL_DAYS=365
MAX_WALLETS_PER_SYNC_CYCLE=25
RAW_RESPONSE_RETENTION_DAYS=30

# --------------------------------------------------------- follower delays
# Seconds. 0 is kept only as a theoretical upper bound.
FOLLOWER_DELAYS_SECONDS=0,2,5,10,15,30,60,120,300
# The delay behind every headline "copyable" figure. Must appear in the list
# above and must not be 0 -- no real follower is instant.
BENCHMARK_DELAY_SECONDS=15
# Minimum per-trade price-evidence confidence for a trade to count toward
# copyable ROI. Modelled prices score ~44 and are excluded on purpose: averaging
# assumptions into the headline number manufactures an edge out of nothing.
MIN_COPYABLE_DATA_CONFIDENCE=55

# -------------------------------------------------------------- execution
MODELED_SLIPPAGE_BPS=150
TAKER_FEE_BPS=0
MIN_ORDER_SIZE_USDC=1

# ---------------------------------------------------- alert qualification
ALERT_MIN_TENNIS_TRADES=30
ALERT_MIN_SKILL_SCORE=75
ALERT_MIN_COPYABLE_ROI=0.0
ALERT_MIN_DATA_CONFIDENCE=80
ALERT_MAX_DRAWDOWN=0.40
ALERT_MAX_PRICE_DETERIORATION=0.03
ALERT_MIN_LIQUIDITY_USDC=500
ALERT_MAX_SPREAD=0.05
ALERT_MAX_AGE_LIVE_SECONDS=60
ALERT_MAX_AGE_PREMATCH_SECONDS=600
ALERT_MIN_COPYABILITY_SCORE=60
ALERT_MIN_POSITION_USDC=100

# Consensus alerts. Wallets in one behavioural cluster count once.
CONSENSUS_MIN_WALLETS=3
CONSENSUS_MIN_INDEPENDENT_CLUSTERS=2
CONSENSUS_WINDOW_SECONDS=90
CONSENSUS_MIN_MEDIAN_SKILL=70
CONSENSUS_MIN_MEDIAN_COPYABILITY=70
CONSENSUS_MAX_PRICE_DETERIORATION=0.04

# --------------------------------------------------------- paper trading
# Simulation only. This build cannot place a real order.
PAPER_TRADING_ENABLED=true
PAPER_EXECUTION_DELAY_SECONDS=15
PAPER_STAKE_USDC=5
PAPER_MAX_EXPOSURE_PER_MARKET_USDC=20
PAPER_MAX_TOTAL_EXPOSURE_USDC=50
PAPER_MAX_OPEN_POSITIONS=10
PAPER_DAILY_LOSS_CAP_USDC=25
PAPER_DEFAULT_EXIT_STRATEGY=hold_to_resolution
PAPER_ALLOW_DUPLICATE_SIGNALS=false

# --------------------------------------------------------- notifications
NOTIFICATIONS_ENABLED=true
# Leave blank to use in-app notifications only.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
